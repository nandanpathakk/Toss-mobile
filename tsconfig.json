{
  "compilerOptions": {
    "module": "ESNext",
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "types": ["react", "node"],
    "isolatedModules": true,
    "jsx": "react-native",
    "lib": ["esnext", "dom"],
    "moduleResolution": "node",
    "moduleSuffixes": [".ios", ".android", ""],
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "esnext",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "resolveJsonModule": true
  },
  "globals": ["ios", "android", "web", "__DEV__", "IS_DEV"],
