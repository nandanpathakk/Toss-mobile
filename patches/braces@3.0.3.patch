diff --git a/lib/assert-depth.js b/lib/assert-depth.js
new file mode 100644
--- /dev/null
+++ b/lib/assert-depth.js
@@ -0,0 +1,18 @@
+'use strict';
+
+// Validate iteratively before the upstream recursive walkers execute.
+module.exports = ast => {
+  const pending = [[ast, 0]];
+  const seen = new Set();
+  while (pending.length) {
+    const [node, depth] = pending.pop();
+    if (!node || typeof node !== 'object') continue;
+    if (depth > 64 || seen.has(node)) {
+      throw new RangeError('Panta: brace AST exceeds nesting limit or contains cycles');
+    }
+    seen.add(node);
+    if (Array.isArray(node.nodes)) {
+      for (const child of node.nodes) pending.push([child, depth + 1]);
+    }
+  }
+};
